# Django
SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
STATIC_ROOT=staticfiles
WHITENOISE_USE_FINDERS=true
# Use an absolute persistent path in production, e.g. /media or /home/account/media.
MEDIA_ROOT=media
MEDIA_URL=/media/
# Keep true unless Nginx/Apache/object storage serves MEDIA_URL directly.
DJANGO_SERVE_MEDIA=true
DJANGO_LOG_LEVEL=INFO

# MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=khoboko_law
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set these to true only when HTTPS is configured in production.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Django
SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
STATIC_ROOT=staticfiles
WHITENOISE_USE_FINDERS=true
# Use an absolute persistent path in production, e.g. /media or /home/account/media.
MEDIA_ROOT=media
MEDIA_URL=/media/
# Keep true unless Nginx/Apache/object storage serves MEDIA_URL directly.
DJANGO_SERVE_MEDIA=true
DJANGO_LOG_LEVEL=INFO

# Public origin for canonical URLs, sitemap, robots and social preview images.
# Leave blank to use Site settings > Public website URL.
SITE_URL=
# Optional dedicated URI, e.g. mailto:security@example.com. Falls back to the
# configured firm email, then the website contact form.
SECURITY_CONTACT=
# Review the reporting contact and renew this date before it expires.
SECURITY_EXPIRES=2027-04-01T00:00:00Z

# Form protection: attempts per 15 minutes (contact/login) or per minute (staff).
FORM_CONTACT_IP_LIMIT=5
FORM_CONTACT_EMAIL_LIMIT=3
FORM_LOGIN_IP_LIMIT=20
FORM_LOGIN_ACCOUNT_LIMIT=10
FORM_UPLOAD_LIMIT=20
FORM_STAFF_WRITE_LIMIT=90
# Comma-separated proxy IPs/CIDRs. Leave blank for direct connections.
# Only configure proxies that append or overwrite X-Forwarded-For correctly.
FORM_TRUSTED_PROXIES=

# MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=khoboko_law
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set these to true only when HTTPS is configured in production.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
